{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "MAULIK.EXE Design Tokens",
  "version": "1.0.0",
  "primitive": {
    "color": {
      "obsidian": {
        "950": { "$value": "#06080C", "$type": "color" },
        "900": { "$value": "#0B0E15", "$type": "color" },
        "850": { "$value": "#10141E", "$type": "color" },
        "800": { "$value": "#161C2A", "$type": "color" }
      },
      "slate": {
        "50":  { "$value": "#F8FAFC", "$type": "color" },
        "100": { "$value": "#F1F5F9", "$type": "color" },
        "400": { "$value": "#94A3B8", "$type": "color" },
        "500": { "$value": "#64748B", "$type": "color" }
      },
      "mint": {
        "300": { "$value": "#6EE7B7", "$type": "color" },
        "400": { "$value": "#34D399", "$type": "color" },
        "500": { "$value": "#10B981", "$type": "color" }
      },
      "cyan": {
        "400": { "$value": "#22D3EE", "$type": "color" },
        "500": { "$value": "#06B6D4", "$type": "color" }
      }
    },
    "font": {
      "display": { "$value": "Space Grotesk, system-ui, sans-serif", "$type": "fontFamily" },
      "body": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "JetBrains Mono, monospace", "$type": "fontFamily" }
    }
  },
  "semantic": {
    "surface": {
      "base": { "$value": "{primitive.color.obsidian.950}", "$type": "color" },
      "subtle": { "$value": "{primitive.color.obsidian.900}", "$type": "color" },
      "card": { "$value": "{primitive.color.obsidian.850}", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{primitive.color.slate.50}", "$type": "color" },
      "secondary": { "$value": "{primitive.color.slate.400}", "$type": "color" },
      "muted": { "$value": "{primitive.color.slate.500}", "$type": "color" },
      "accent": { "$value": "{primitive.color.mint.400}", "$type": "color" }
    },
    "accent": {
      "primary": { "$value": "{primitive.color.mint.400}", "$type": "color" },
      "cyan": { "$value": "{primitive.color.cyan.400}", "$type": "color" }
    }
  }
}
